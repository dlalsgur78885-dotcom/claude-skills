# Copy to .env on the server and fill in real values.
# Used by docker-compose.

# Domain (for ALLOWED_ORIGINS default + nginx ssl cert path)
DOMAIN=your-domain.com

# JWT — MUST set to a long random string in production
# Generate: openssl rand -hex 64
SECRET_KEY=

# LLM / Vision
GEMINI_API_KEY=

# Instagram data
HIKER_API_KEY=

# Stock photo APIs (optional but recommended)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Outbound scraping proxy pool (Naver image search)
# Format: country:url;country:url;default:url
# Example: jp:http://u:p@jp.proxy:6969;kr:http://u:p@kr.proxy:6969;default:http://u:p@global.proxy:6969
SCRAPING_PROXY_URLS=

# CORS — comma-separated. Leave blank to use https://${DOMAIN} from above.
# Override if you have multiple frontends (staging.example.com,example.com)
ALLOWED_ORIGINS=
