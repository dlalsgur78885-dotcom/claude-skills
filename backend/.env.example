# HikerAPI (Instagram data) - https://hikerapi.com
HIKER_API_KEY=your-hiker-api-key

# Transparent Image Sourcing (우선순위 순)
PIXABAY_API_KEY=your-pixabay-key          # 1순위: 투명 스톡 (무료) - https://pixabay.com/api/docs/
FLATICON_API_KEY=your-flaticon-key        # 2순위: 투명 아이콘 - https://developer.flaticon.com
OPENAI_API_KEY=your-openai-key            # 3순위: AI 누끼 생성 ($0.01~0.17/장)
REMOVEBG_API_KEY=your-removebg-key        # 폴백: 배경 제거 - https://www.remove.bg/api

# Stock Images (일반)
UNSPLASH_ACCESS_KEY=your-unsplash-key
PEXELS_API_KEY=your-pexels-key

# AI / LLM
GOOGLE_API_KEY=your-google-genai-key

# Instagram Publishing (맨 마지막에 구현)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
INSTAGRAM_ACCESS_TOKEN=your-ig-access-token

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
