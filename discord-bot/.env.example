# 복사해서 .env 로 쓴다. .env 는 절대 커밋하지 않는다.

# ── 디스코드 ────────────────────────────────────────────────
# 개발자 포털(discord.com/developers/applications) → Bot → Reset Token
# ⚠ Bot 탭에서 MESSAGE CONTENT INTENT 를 켜야 봇이 글을 읽는다.
DISCORD_TOKEN=

# ── 캐러셀 백엔드 ───────────────────────────────────────────
# dev  : https://3-35-18-166.sslip.io:3443/api
# prod : https://3-35-18-166.sslip.io/api
CAROUSEL_API_BASE=https://3-35-18-166.sslip.io:3443/api

# ── 채널 → 계정 매핑 ────────────────────────────────────────
# 디스코드 채널 ID 로 어느 계정으로 일할지 정한다. 매핑에 없는 채널은 무시한다.
# 채널 ID: 디스코드에서 개발자 모드 켜고 채널 우클릭 → "채널 ID 복사"
# 형식: <채널ID>:<사용자명>:<비밀번호>;<채널ID>:<사용자명>:<비밀번호>
# 예)   1234567890:junhyeok:1234;9876543210:solhee:1234
CHANNEL_ACCOUNTS=

# ── LLM (Gemini REST) ──────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── 승인 담당자 ─────────────────────────────────────────────
# 삭제처럼 되돌리기 어려운 작업은 이 사람들에게 확인을 받는다.
# 디스코드 사용자 ID 를 쉼표로. 비우면 위험 작업이 전부 거부된다.
APPROVER_IDS=

# ── 동작 ───────────────────────────────────────────────────
# 한 번에 처리할 작업 수. 박스가 1.9GB 라 넉넉히 잡지 않는다.
JOB_CONCURRENCY=2
# 대화 세션 유지: 턴 수 / 시간(분)
SESSION_MAX_TURNS=8
SESSION_MAX_AGE_MIN=120
